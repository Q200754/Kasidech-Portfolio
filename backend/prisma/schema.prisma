datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
}

model Profile {
  id         String @id @default(uuid())
  fullNameTh String
  bioTh      String
  email      String
}

model Project {
  id          String   @id @default(uuid())
  titleTh     String
  shortDescTh String
  coverImage  String
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}